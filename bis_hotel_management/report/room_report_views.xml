<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_room_report_pivot" model="ir.ui.view">
         <field name="name">room.report.pivot</field>
         <field name="model">hotel.room.report</field>
         <field name="arch" type="xml">
             <pivot string="Rooms Analysis" sample="1">
                 <field name="name" type="col"/>
                 <field name="booking_date" interval="month" type="row"/>
             </pivot>
         </field>
    </record>

    <record id="view_hotel_room_report_graph" model="ir.ui.view">
         <field name="name">room.report.graph</field>
         <field name="model">hotel.room.report</field>
         <field name="arch" type="xml">
             <graph string="Rooms Analysis" type="line" sample="1">
                 <field name="booking_date" interval="day"/>
                 <field name="hotel_id" type="measure"/>
             </graph>
         </field>
    </record>

    <record id="room_report_graph_pie" model="ir.ui.view">
         <field name="name">room.report.graph.pie</field>
         <field name="model">hotel.room.report</field>
         <field name="mode">primary</field>
         <field name="inherit_id" ref="view_hotel_room_report_graph"/>
         <field name="arch" type="xml">
            <graph position="attributes">
                <attribute name="type">pie</attribute>
            </graph>
         </field>
    </record>

     <record id="room_report_graph_bar" model="ir.ui.view">
         <field name="name">room.report.graph.bar</field>
         <field name="model">hotel.room.report</field>
         <field name="mode">primary</field>
         <field name="inherit_id" ref="view_hotel_room_report_graph"/>
         <field name="arch" type="xml">
            <graph position="attributes">
                <attribute name="type">bar</attribute>
                <attribute name="order">DESC</attribute>
            </graph>
         </field>
    </record>

    <record id="room_report_view_tree" model="ir.ui.view">
        <field name="name">room.report.view.tree</field>
        <field name="model">hotel.room.report</field>
        <field name="arch" type="xml">
           <tree edit="False" create="True">
              <field name="sequence"/>
              <field name="name"/>
              <field name="hotel_id"/>
              <field name="booking_date"/>
              <field name="checkin_date"/>
              <field name="checkout_date"/>
              <field name="status_booking" widget="badge"
                     decoration-info="status_booking == 'draft'"
                     decoration-warning="status_booking == 'booking'"
                     decoration-success="status_booking == 'checkin'"
                     decoration-danger="status_booking == 'checkout'"
                />
            </tree>
        </field>
    </record>

    <record id="view_room_report_search" model="ir.ui.view">
        <field name="name">room.report.search</field>
        <field name="model">hotel.room.report</field>
        <field name="arch" type="xml">
            <search string="rooms Analysis">
                <field name="booking_date"/>
                <filter string="Date" name="year" invisible="1" date="booking_date" default_period="this_year"/>
                <separator/>
                <filter name="filter_date" date="booking_date" default_period="this_month"/>
                <filter name="filter_booking_date" invisible="1" string="Order Date: Last 365 Days" domain="[('booking_date', '&gt;=', (datetime.datetime.combine(context_today() + relativedelta(days=-365), datetime.time(0,0,0))).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <separator/>
                <group expand="1" string="Group By">
                    <filter string="Rooms" name="rooms" context="{'group_by':'name'}"/>
                    <filter string="Status" name="status_booking" context="{'group_by':'status_booking'}"/>
                    <separator/>
                    <filter string="Booking Date" name="booking_date" context="{'group_by':'booking_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_room_report" model="ir.actions.act_window">
        <field name="name">Rooms Analysis</field>
        <field name="res_model">hotel.room.report</field>
        <field name="view_mode">pivot,tree,graph</field>
        <field name="view_id" ref="room_report_view_tree"/>
        <field name="domain">[]</field>
<!--        <field name="domain">[('status_booking','not in',('cancel'))]</field>-->
        <field name="context">{
            'search_default_rooms': 1,
            'search_default_filter_date': 1}</field>
        <field name="help">
        </field>
    </record>
</odoo>
