<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="sale_order_form_inherit_new">
            <field name="name">sale.order.form.inherit.new</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <field name="date_order" position="attributes">
                    <atrribute name="invisible">not name</atrribute>
                </field>
                <xpath expr="//group[@name='sales_person']//field[@name='user_id']" position="attributes">
                    <atrribute name="invisible">not name</atrribute>
                </xpath>
                <field name="payment_term_id" position="after">
                    <field name="user_id" widget="many2one_avatar_user"/>
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="hotel_room_inherit_form">
            <field name="name">hotel_room_inherit_form</field>
            <field name="model">hotel.room</field>
            <field name="inherit_id" ref="bis_hotel_management.bis_hotel_management_hotel_room_form"/>
            <field name="arch" type="xml">
<!--                <xpath expr="//field[@name='hotel_id']" position="after">-->
<!--                <xpath expr="//group/group[2]" position="inside">-->
<!--                    <field name="casher_id"/>-->
<!--                </xpath>-->
                <field name="checkout_date" position="after">
                    <field name="description"/>
                    <field name="note"/>
                </field>
                <field name="booking_date" position="after">
                    <field name="casher_id"/>
                </field>
                <field name="sequence" position="attributes">
                    <attribute name="readonly">True</attribute>
                </field>
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page name="note">
                            <field name="note"/>
                        </page>
                        <page name="casher">
                            <group>
                                <group>
                                    <field name="description"/>
                                </group>
                                <group>
                                    <field name="casher_id"/>
                                </group>
                            </group>
                        </page>
                        <page name="note3">
                            <field name="note"/>
                        </page>
                        <page name="note4">
                            <field name="note"/>
                        </page>
                        <page name="note5">
                            <field name="note"/>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
    </data>
</odoo>