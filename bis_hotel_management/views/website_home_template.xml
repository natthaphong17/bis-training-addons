                        </div>
                        <div class="o_grid_item o_grid_item_image g-col-lg-3 g-height-5 col-lg-3 d-lg-block d-none o_snippet_mobile_invisible o_colored_level" style="z-index: 4; grid-area: 7 / 7 / 12 / 10;" data-invisible="1">
